# OpenAI API Configuration (Required)
# Get your API key from: https://openrouter.ai/keys or your OpenAI provider
OPENAI_API_KEY=your-api-key-here

# Optional: API Base URL (defaults to OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: Model Configuration (defaults to gpt-4.1-mini)
# ANALYSIS_MODEL=openai/gpt-4.1-mini
# RESPONSE_MODEL=openai/gpt-4.1-mini

# Optional: Persona Configuration (defaults to girlfriend.toml)
# PERSONA_PATH=config/personas/girlfriend.toml

# Optional: Temperature Settings
# ANALYSIS_TEMPERATURE=0.1
# RESPONSE_TEMPERATURE=0.8
